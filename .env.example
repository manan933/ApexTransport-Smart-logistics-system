# Database Settings (Neon, Railway, Render, Supabase PostgreSQL)
# If DB_URL is omitted or contains h2, the system automatically falls back to embedded H2 for instant local demo.
DB_URL=jdbc:postgresql://ep-example.neon.tech:5432/apex_transport?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_secure_password

# Server Port (Auto-provided by Railway/Render/Heroku via $PORT)
PORT=8080

# Firebase Cloud Storage & Admin SDK (Optional)
FIREBASE_BUCKET_NAME=apex-transport-demo.appspot.com
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
# Or path to JSON file:
# FIREBASE_CONFIG_PATH=/app/firebase-service-account.json
