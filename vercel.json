{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "src/main/resources/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/src/main/resources/static/login.html"
    },
    {
      "src": "^/login$",
      "dest": "/src/main/resources/static/login.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/src/main/resources/static/$1"
    }
  ]
}
